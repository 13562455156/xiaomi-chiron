deviceinfo_name="Mi MIX 2"
deviceinfo_manufacturer="Xiaomi"
deviceinfo_codename="chiron"
deviceinfo_arch="aarch64"
deviceinfo_halium_version="9"
deviceinfo_ubuntu_touch_release="24.04-2.x"
deviceinfo_use_overlaystore="true"
# 注意：共享内核 halium-9.0 分支只有 sagit_defconfig，没有 chiron_defconfig。
# 必须 fork 该内核仓库，把本仓库 kernel/chiron_defconfig 放入
# arch/arm64/configs/ 后，再把下面两行指向你的 fork（保持分支名 halium-9.0）。
deviceinfo_kernel_source="https://gitlab.com/alimentu273/android_kernel_xiaomi_msm8998.git"
deviceinfo_kernel_source_branch="halium-9.0"
deviceinfo_kernel_defconfig="chiron_defconfig"
# cmdline 与 Mi 6 (sagit) 完全一致；systempart 用 by-partlabel（halium initramfs 由 udev
# 生成）。若 chiron 首启找不到 system，再改回 /dev/block/bootdevice/by-name/system。
deviceinfo_kernel_cmdline="androidboot.console=ttyMSM0 androidboot.hardware=qcom user_debug=31 msm_rtb.filter=0x37 ehci-hcd.park=3 service_locator.enable=1 swiotlb=2048 console=tty0 systempart=/dev/disk/by-partlabel/system"
deviceinfo_kernel_clang_compile="false"
deviceinfo_kernel_apply_overlay="false"
deviceinfo_generate_bootimg="true"
deviceinfo_bootimg_header_version="1"
deviceinfo_bootimg_os_version="9"
deviceinfo_bootimg_os_patch_level="2018-12"
deviceinfo_bootimg_qcdt="false"
deviceinfo_system_partition_size="5120M"
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x01000000"
deviceinfo_flash_offset_second="0x00f00000"
deviceinfo_flash_offset_tags="0x00000100"
deviceinfo_flash_pagesize="4096"
